{
  "compilerOptions": {
      "target": "es6",
      "module": "commonjs",
      "outDir": "./",
      "moduleResolution": "node",
      "skipLibCheck": true,
      "preserveConstEnums": true,
      "sourceMap": false,
      "allowJs": true,
      "declaration": true,
      "strict": true,
      "strictNullChecks": true,
      "strictPropertyInitialization": false,
      "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "testProject"
  ]
}