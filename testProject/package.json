{
  "name": "example",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "@sap/xb-msg-amqp-v100": "^0.9.58",
    "cds-event-monitoring": "../"
  },
  "devDependencies": {
    "@cap-js/hana": "^1",
    "@cap-js/sqlite": "^1",
    "@sap/ux-specification": "^1.124.15"
  },
  "scripts": {
    "start": "cds-serve",
    "cds:watch": "DEBUG=sql cds watch --profile hybrid",
    "watch-event-monitoring-app": "cds watch --open event-monitoring-app/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sql",
        "credentials": {
          "url": ":memory:"
        }
      },
      "messaging": {
        "kind": "enterprise-messaging",
        "[hybrid]": {
          "kind": "enterprise-messaging-shared"
        },
        "[test]": {
          "kind": "local-messaging"
        }
      },
      "event-monitoring": {
        "retentionInDays": 7,
        "ignoreIdenticalEvents": true,
        "topics": [
          "plugin/example/1/test",
          "plugin/example/1/test2"
        ],
        "dead-message-queues": [
          "plugin/example/1/dead-message-queue"
        ]
      }
    }
  },
  "sapux": [
    "app/event-monitoring-app"
  ]
}
